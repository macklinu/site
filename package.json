{
  "name": "mackie",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "cheatsheets:sync": "tsx --env-file-if-exists=apps/cli/.env apps/cli/src/main.ts cheatsheets sync",
    "cheatsheets:sync-neru": "tsx --env-file-if-exists=apps/cli/.env apps/cli/src/main.ts cheatsheets sync-neru",
    "build": "turbo run build",
    "deploy": "turbo run deploy",
    "destroy": "turbo run destroy",
    "lint": "oxlint --disable-nested-config",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --check --disable-nested-config .",
    "apps/cli": "pnpm --dir apps/cli run start"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
