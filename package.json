{
  "name": "mackie",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "deploy": "turbo run deploy",
    "destroy": "turbo run destroy",
    "lint": "oxlint --disable-nested-config",
    "format": "oxfmt --disable-nested-config",
    "format:astro": "prettier --write 'apps/web/src/**/*.astro'",
    "format:check": "oxfmt --check --disable-nested-config . && prettier --check 'apps/web/src/**/*.astro'",
    "apps/cli": "pnpm --dir apps/cli run start"
  },
  "devDependencies": {
    "@macklinu/oxfmt-config": "^1.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
