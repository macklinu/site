---
import SiteShell from '~/layouts/SiteShell.astro'

interface Props {
  title?: string
  description: string
  ogImage?: string
  type?: 'website' | 'article'
  publishedTime?: string
  modifiedTime?: string
}
---

<SiteShell {...Astro.props}>
  <main class='mx-auto w-[min(100%-3rem,84rem)] max-handset:w-[min(100%-2rem,42rem)]'>
    <slot />
  </main>
</SiteShell>
