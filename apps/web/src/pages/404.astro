---
import Layout from '~/Layout.astro'
---

<Layout title='Not Found' description='The requested page was not found'>
  <article class='m-0 w-full max-w-[38rem] pt-[clamp(2.5rem,5vw,4.5rem)] pb-16'>
    <header class='mb-[clamp(2rem,4vw,3rem)] max-w-[38rem] border-b-2 border-site-ink pb-7'>
      <p class='inline-flex bg-site-coral px-1 py-1 font-mono text-xs leading-[1.35] tracking-[0.04em] text-site-paper'>404</p>
      <h1 class='mt-4 mb-6 max-w-[13ch] font-display text-[clamp(2.6rem,5vw,4.5rem)] font-bold leading-[0.88] tracking-[-0.07em] [font-variation-settings:"opsz"_48,_"wdth"_88]'>Not found</h1>
      <p class='-mt-2 max-w-[34rem] text-lg leading-[1.5] text-site-muted'>That page does not exist.</p>
    </header>
    <div class='prose max-w-[38rem] font-body text-[1.0625rem] leading-7 text-site-ink'>
      <p><a href='/'>Return home.</a></p>
    </div>
  </article>
</Layout>
