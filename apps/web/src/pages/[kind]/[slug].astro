---
import { getCollection, render } from 'astro:content'
import { DateTime, Effect } from 'effect'

import EntryArticle from '~/components/EntryArticle.astro'
import Layout from '~/Layout.astro'
import { Runtime } from '~/lib/Runtime'


export const getStaticPaths = () =>
  Runtime.runPromise(
    Effect.tryPromise(() =>
      Promise.all([
        getCollection('notes'),
        getCollection('demos'),
        getCollection('guides'),
      ])
    ).pipe(
      Effect.map(([notes, demos, guides]) => [
        ...notes.map((entry) => ({
          params: { kind: 'notes', slug: entry.id },
          props: { entry },
        })),
        ...demos.map((entry) => ({
          params: { kind: 'demos', slug: entry.id },
          props: { entry },
        })),
        ...guides.map((entry) => ({
          params: { kind: 'guides', slug: entry.id },
          props: { entry },
        })),
      ]),
      Effect.orDie,
      Effect.withSpan('listContentStaticPaths')
    )
  )

const { entry } = Astro.props
const { Content } = await render(entry)
const date = 'updated' in entry.data ? entry.data.updated : entry.data.date
const publicationDate = DateTime.makeUnsafe(date)
const ogImage = new URL(`/${entry.data.kind}s/${entry.id}/og.png`, import.meta.env.SITE).toString()
---

<Layout title={entry.data.title} description={entry.data.description} ogImage={ogImage} type='article'>
  <EntryArticle
    title={entry.data.title}
    kind={entry.data.kind}
    date={publicationDate}
  >
    <Content />
  </EntryArticle>
</Layout>
