---
import type { InferGetStaticPropsType } from 'astro'
import { render } from 'astro:content'
import { DateTime, Effect } from 'effect'

import EntryArticle from '~/components/EntryArticle.astro'
import Layout from '~/Layout.astro'
import { listContentRoutes } from '~/lib/ContentRoute'

export const getStaticPaths = () =>
  Effect.runPromise(
    listContentRoutes().pipe(
      Effect.map((routes) =>
        routes.map((route) => ({
          params: { kind: route.kind, slug: route.entry.id },
          props: {
            entry: route.entry,
            kind: route.kind,
          },
        })),
      ),
    ),
  );
type Props = InferGetStaticPropsType<typeof getStaticPaths>


const { entry, kind } = Astro.props
const { Content } = await render(entry)
const publicationDate = DateTime.makeUnsafe(entry.data.date)
const updatedAt = entry.data.updatedAt ? DateTime.makeUnsafe(entry.data.updatedAt) : undefined
const ogImage = new URL(`/${kind}/${entry.id}/og.png`, import.meta.env.SITE).toString()
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={ogImage}
  type='article'
  publishedTime={DateTime.formatIso(publicationDate)}
  modifiedTime={updatedAt && DateTime.formatIso(updatedAt)}
>
  <EntryArticle
    title={entry.data.title}
    kind={entry.data.kind}
    date={publicationDate}
    updatedAt={updatedAt}
  >
    <Content />
  </EntryArticle>
</Layout>
