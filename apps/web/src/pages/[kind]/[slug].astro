---
import { getCollection, render } from 'astro:content'

import EntryArticle from '~/components/EntryArticle.astro'
import Layout from '~/Layout.astro'
import { formatFullDate } from '~/lib/DateFormat'

export async function getStaticPaths() {
  const [notes, interactives, guides] = await Promise.all([
    getCollection('notes'),
    getCollection('interactives'),
    getCollection('guides'),
  ])

  return [
    ...notes.map((entry) => ({
      params: { kind: 'notes', slug: entry.id },
      props: { entry },
    })),
    ...interactives.map((entry) => ({
      params: { kind: 'demos', slug: entry.id },
      props: { entry },
    })),
    ...guides.map((entry) => ({
      params: { kind: 'guides', slug: entry.id },
      props: { entry },
    })),
  ]
}

const { entry } = Astro.props
const { Content } = await render(entry)
const date = 'updated' in entry.data ? entry.data.updated : entry.data.date
const dateLabel = formatFullDate(Date.parse(`${date}T00:00:00.000Z`))
const routeKind = entry.data.kind === 'interactive' ? 'demos' : `${entry.data.kind}s`
const ogImage = new URL(`/${routeKind}/${entry.id}/og.png`, import.meta.env.SITE).toString()
---

<Layout title={entry.data.title} description={entry.data.description} ogImage={ogImage} type='article'>
  <EntryArticle
    title={entry.data.title}
    kind={entry.data.kind}
    date={dateLabel}
    dateTime={date}
  >
    <Content />
  </EntryArticle>
</Layout>
