---
import { render } from 'astro:content'
import { DateTime, Effect } from 'effect'

import EntryArticle from '~/components/EntryArticle.astro'
import Layout from '~/Layout.astro'
import { listContentRoutes } from '~/lib/ContentRoute'

export const getStaticPaths = () =>
  Effect.runPromise(
    listContentRoutes().pipe(
      Effect.map((routes) =>
        routes.map(({ kind, entry }) => ({
          params: { kind, slug: entry.id },
          props: { entry, kind },
        })),
      ),
    ),
  );

const { entry, kind } = Astro.props
const { Content } = await render(entry)
const date = 'updated' in entry.data ? entry.data.updated : entry.data.date
const publicationDate = DateTime.makeUnsafe(date)
const ogImage = new URL(`/${kind}/${entry.id}/og.png`, import.meta.env.SITE).toString()
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={ogImage}
  type='article'
  publishedTime={DateTime.formatIso(publicationDate)}
>
  <EntryArticle
    title={entry.data.title}
    kind={entry.data.kind}
    date={publicationDate}
  >
    <Content />
  </EntryArticle>
</Layout>
