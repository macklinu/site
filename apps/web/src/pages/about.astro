---
import Layout from '~/Layout.astro'
import { author } from '~/lib/Author'
---

<Layout title='About' description={author.bio}>
  <article class='m-0 w-full max-w-[38rem] pt-[clamp(2.5rem,5vw,4.5rem)] pb-16'>
    <header class='mb-[clamp(2rem,4vw,3rem)] max-w-[38rem]'>
      <h1 class='m-0 mb-3 max-w-[13ch] font-display text-[clamp(2.6rem,5vw,4.5rem)] font-bold leading-[0.88] tracking-[-0.045em] [font-variation-settings:"opsz"_48,_"wdth"_94]'>
        {author.name}
      </h1>
      <p class='m-0 max-w-[34rem] text-lg leading-[1.5] text-site-muted'>
        {author.bio}.
      </p>
    </header>
    <div class='prose max-w-[38rem] font-body text-[1.0625rem] leading-7 text-site-ink'>
      <h2>Elsewhere</h2>
      <ul>
        <li>
          <a href={`https://github.com/${author.githubHandle.slice(1)}`}>
            GitHub
          </a>
        </li>
        <li>
          <a href={`https://x.com/${author.twitterHandle.slice(1)}`}>Twitter</a>
        </li>
        <li>
          <a
            href={`https://www.linkedin.com/in/${author.linkedinHandle.slice(1)}`}
          >
            LinkedIn
          </a>
        </li>
      </ul>
    </div>
  </article>
</Layout>
