---
import Layout from '~/Layout.astro'
---

<Layout
  title='Places'
  description='A short list of cities worth returning to, starting with San Francisco.'
>
  <article class='w-full max-w-[48rem] py-[clamp(2.5rem,5vw,4.5rem)] pb-16'>
    <header>
      <h1 class='m-0 font-display text-[clamp(2.75rem,5vw,4.5rem)] font-bold leading-[0.88] tracking-[-0.045em] [font-variation-settings:"opsz"_48,_"wdth"_94]'>
        Places to return to
      </h1>
    </header>

    <section class='mt-10' aria-labelledby='cities-title'>
      <h2
        id='cities-title'
        class='mb-3 font-display text-[clamp(1.9rem,2.7vw,2.8rem)] font-bold leading-[0.9] tracking-[-0.025em]'
      >
        Cities
      </h2>
      <ul class='m-0 list-none border-t border-site-ink p-0'>
        <li class='border-b border-site-line'>
          <a
            class='group grid min-h-24 grid-cols-[minmax(0,1fr)_1.5rem] items-start gap-6 px-2 py-4 text-inherit no-underline transition-colors duration-150 ease-out hover:bg-site-surface focus-visible:bg-site-surface'
            href='/places/san-francisco'
          >
            <div>
              <h3 class='m-0 font-body text-[clamp(1.05rem,1.4vw,1.28rem)] font-[650] leading-[1.2] tracking-[-0.025em] underline decoration-2 decoration-transparent underline-offset-[0.2em] transition-colors duration-150 ease-out group-hover:decoration-site-blue group-focus-visible:decoration-site-blue'>
                San Francisco
              </h3>
              <p class='mt-1 mb-0 text-[0.9375rem] leading-[1.45] text-site-muted'>
                A compact tour for a first visit: waterfront, bookstores, parks,
                and a long walk by the Pacific.
              </p>
            </div>
            <span
              class='self-center font-mono text-[1.05rem] leading-none transition-transform duration-200 ease-out group-hover:translate-x-1 group-hover:-translate-y-1 group-focus-visible:translate-x-1 group-focus-visible:-translate-y-1'
              aria-hidden='true'
            >
              →
            </span>
          </a>
        </li>
      </ul>
    </section>
  </article>
</Layout>
