---
import type { EntryKind } from '~/lib/EntryService'

type ContentKind = EntryKind | 'place'

interface Props {
  kind: ContentKind
  class?: string
}

const { kind, class: className } = Astro.props

const labels: Record<ContentKind, string> = {
  article: 'post',
  note: 'note',
  demo: 'demo',
  guide: 'guide',
  place: 'place',
}

const variants: Record<ContentKind, string> = {
  article: 'border border-site-muted bg-site-paper text-site-muted',
  note: 'border border-dashed border-site-muted bg-site-paper text-site-muted',
  demo: 'border border-dotted border-site-muted bg-site-paper text-site-muted',
  guide: 'border-2 border-site-muted bg-site-paper text-site-muted',
  place: 'border border-site-muted bg-site-paper text-site-muted',
}
---

<span
  class:list={[
    'inline-flex w-fit items-center px-1 py-1 font-mono text-xs leading-[1.35] tracking-[0.04em]',
    variants[kind],
    className,
  ]}
  data-kind={kind}
>
  {labels[kind]}
</span>
